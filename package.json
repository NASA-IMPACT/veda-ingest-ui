{
  "name": "veda-ingest-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "yarn lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest",
    "test:e2e": "yarn build && yarn playwright test",
    "test:coverage": "vitest run --coverage --testTimeout=15000 --hookTimeout=15000",
    "test:coverage:threshold": "vitest run --coverage --reporter=verbose --testTimeout=15000 --hookTimeout=15000",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true yarn build",
    "deps:check": "yarn outdated",
    "deps:audit": "yarn audit",
    "clean": "rm -rf .next out coverage test-results"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.0.2",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@aws-amplify/adapter-nextjs": "^1.7.3",
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/client-secrets-manager": "^3.1115.0",
    "@aws-sdk/client-sts": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@logtape/logtape": "^2.3.2",
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "@rjsf/antd": "^6.8.0",
    "@rjsf/core": "^6.8.0",
    "@rjsf/utils": "^6.8.0",
    "@rjsf/validator-ajv8": "^6.8.0",
    "@uiw/react-textarea-code-editor": "^3.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "antd": "6.6.1",
    "aws-amplify": "^6.20.0",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.1.1",
    "json-schema": "^0.4.0",
    "leaflet": "^1.9.4",
    "lodash": "~4.18.1",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "next-remove-imports": "^1.0.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "virtual-react-json-diff": "^1.0.19"
  },
  "devDependencies": {
    "@octokit/types": "^17.0.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/leaflet": "^1.9.22",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "eslint": "^10",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "pin-github-action": "3.5.2",
    "playwright-msw": "^3.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.11"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "yarn lint:fix",
      "prettier --write"
    ]
  },
  "resolutions": {
    "fast-xml-parser": "5.7.0",
    "uuid": "14.0.0",
    "eslint/minimatch": "3.1.4",
    "@eslint/eslintrc/minimatch": "3.1.4",
    "@humanwhocodes/config-array/minimatch": "3.1.4",
    "eslint-plugin-import/minimatch": "3.1.4",
    "eslint-plugin-jsx-a11y/minimatch": "3.1.4",
    "eslint-plugin-react/minimatch": "3.1.4"
  },
  "packageManager": "yarn@4.13.0"
}
